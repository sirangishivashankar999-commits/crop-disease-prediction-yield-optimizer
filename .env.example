# CROPWISE AI - Server Environment Configuration Template
# Copy this file to '.env' on your backend server and set your AI provider credentials.
# NOTE: Do NOT commit your actual '.env' file containing secrets to version control.

# AI Assistant Provider Credentials
# Any OpenAI-compatible service is supported (OpenAI, Groq, OpenRouter, Together, Local Ollama, etc.)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Example for Groq:
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1

# Example for OpenRouter:
# AI_API_KEY=sk-or-...
# AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
# AI_BASE_URL=https://openrouter.ai/api/v1
